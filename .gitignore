# ============================================================================
# CEE 598 Final Project — .gitignore
# ============================================================================

# ---- FAA proprietary / licensed material (never commit) -------------------
FAARFIELD_2.1.1_SourceCode/
FAARFIELD_2.1.1_Installation Files/
*.dll
*.pdb
*.ilk
*.exp

# ---- Massive reference archives (2 GB+, not part of deliverable) -----------
PaveAir/

# ---- Excel/Office lock & temp files ----------------------------------------
~$*
*.tmp
*.bak
*.swp
*.swo

# ---- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Website (snapshot at website/) — exclude build artifacts --------------
website/node_modules/
website/dist/
website/.vite/
website/.cache/
website/faarfield-api/bin/
website/faarfield-api/obj/
website/coverage/
website/.env
website/.env.local

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- Node/JS ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- VB.NET / .NET build outputs (defense in depth) -----------------------
bin/
obj/
*.user
*.suo

# ---- Logs / scratch / large-but-regenerable --------------------------------
*.log
scripts/*.log
scripts/output/
scripts/cache/

# ---- IDE settings (per-user, not project) ---------------------------------
.idea/
.vscode/
!.vscode/settings.json.example

# ---- Claude / agent runtime files ------------------------------------------
.claude/cache/
.claude/state/
.claude/logs/

# ---- Sensitive ------------------------------------------------------------
.env
.env.*
!.env.example
secrets.json
credentials.json
*.key
*.pem
